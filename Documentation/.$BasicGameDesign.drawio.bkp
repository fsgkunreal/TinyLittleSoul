  <diagram id="gLOPQHQF1JWpWy8sPNWI" name="Прогрессия">
    <mxGraphModel dx="2531" dy="1023" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="uRHP9P7_gQd_6kNDkDM7-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;Прогрессия&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Реализуется в виде неявной прогрессии. Вместе с явной прогрессией вроде прокачки персонажа используется прогрессия через сложность и локации, то есть чем дальше игрок проходит, тем сложнее испытания и другие декорации.&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="390" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="uRHP9P7_gQd_6kNDkDM7-18" edge="1" parent="1" source="uRHP9P7_gQd_6kNDkDM7-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" target="uRHP9P7_gQd_6kNDkDM7-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WaVrvkezlG4t53rYaskV-2" edge="1" parent="1" source="uRHP9P7_gQd_6kNDkDM7-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="WaVrvkezlG4t53rYaskV-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uRHP9P7_gQd_6kNDkDM7-3" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Крепость" vertex="1">
          <mxGeometry height="540" width="230" y="550" as="geometry" />
        </mxCell>
        <mxCell id="uRHP9P7_gQd_6kNDkDM7-4" parent="uRHP9P7_gQd_6kNDkDM7-3" style="text;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontColor=#333333;" value="Руины крепости, которая была полем древней битвы Ангелов и Титанов. Мрачное безжизненное место. Открытых пространств нет, только руины крепости.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Начальная локация, при прохождении которой нужно ввести игрока в работу основных механик передвижения, платформинга и сущностей.&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="230" y="30" as="geometry" />
        </mxCell>
        <mxCell id="uRHP9P7_gQd_6kNDkDM7-10" parent="uRHP9P7_gQd_6kNDkDM7-3" style="text;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="В качестве референса использовать Царство Аида из дополнения к Assassin&#39;s Creed: Odyssey - Судьба Атлантиды." vertex="1">
          <mxGeometry height="170" width="230" y="200" as="geometry" />
        </mxCell>
        <mxCell id="uRHP9P7_gQd_6kNDkDM7-12" parent="uRHP9P7_gQd_6kNDkDM7-3" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="На прохождение локации должно уходить у новичков в среднем &lt;b&gt;10-20 минут&lt;/b&gt;. Если уходит меньше или больше - корректировать уровень." vertex="1">
          <mxGeometry height="170" width="230" y="370" as="geometry" />
        </mxCell>
        <mxCell id="ia-_MZTyq4ksZtsAZTBB-3" edge="1" parent="1" source="uRHP9P7_gQd_6kNDkDM7-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="uRHP9P7_gQd_6kNDkDM7-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uRHP9P7_gQd_6kNDkDM7-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Локации&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="55" y="445" as="geometry" />
        </mxCell>
        <mxCell id="ia-_MZTyq4ksZtsAZTBB-8" edge="1" parent="1" source="uRHP9P7_gQd_6kNDkDM7-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" target="ia-_MZTyq4ksZtsAZTBB-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uRHP9P7_gQd_6kNDkDM7-13" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Шахта (или катакомбы)" vertex="1">
          <mxGeometry height="540" width="230" x="295" y="550" as="geometry" />
        </mxCell>
        <mxCell id="uRHP9P7_gQd_6kNDkDM7-14" parent="uRHP9P7_gQd_6kNDkDM7-13" style="text;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontColor=#333333;" value="Тёмное место с ограниченным пространством. Больше упор на головоломки чем на платформинг, хотя и им нельзя пренебрегать. Головоломки умеренные, без лишней сложности." vertex="1">
          <mxGeometry height="170" width="230" y="30" as="geometry" />
        </mxCell>
        <mxCell id="uRHP9P7_gQd_6kNDkDM7-15" parent="uRHP9P7_gQd_6kNDkDM7-13" style="text;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Никаких особых референсов, обычная шахта. Как вариант - шахта из фильма Индиана Джонс и Храм Судьбы." vertex="1">
          <mxGeometry height="170" width="230" y="200" as="geometry" />
        </mxCell>
        <mxCell id="uRHP9P7_gQd_6kNDkDM7-16" parent="uRHP9P7_gQd_6kNDkDM7-13" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Проходная локация для ознакомления игрока с механиками головоломки. На прохождение у новичка должно уходить в среднем &lt;b&gt;5-10 минут&lt;/b&gt;." vertex="1">
          <mxGeometry height="170" width="230" y="370" as="geometry" />
        </mxCell>
        <mxCell id="ia-_MZTyq4ksZtsAZTBB-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=30;fontStyle=1" value="Неявная прогрессия" vertex="1">
          <mxGeometry height="30" width="350" x="95" y="370" as="geometry" />
        </mxCell>
        <mxCell id="ia-_MZTyq4ksZtsAZTBB-4" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Руины башни" vertex="1">
