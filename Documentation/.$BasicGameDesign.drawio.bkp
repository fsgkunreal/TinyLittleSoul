        <mxCell id="_nKmKHA1e7HajRSAZLVX-15" parent="_nKmKHA1e7HajRSAZLVX-13" style="text;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Отличница, уделяющая много времени учёбе." vertex="1">
          <mxGeometry height="80" width="179" y="60" as="geometry" />
        </mxCell>
        <mxCell id="_nKmKHA1e7HajRSAZLVX-16" parent="_nKmKHA1e7HajRSAZLVX-13" style="text;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Много времени посвящает учёбе, но при этом любит разгрузить голову в играх. Ей не нравятся сложные игры. Из-за образа жизни может уделять играм по 30 минут в день." vertex="1">
          <mxGeometry height="140" width="179" y="140" as="geometry" />
        </mxCell>
        <mxCell id="f7H6KHkmW85j-XaXgy8H-9" parent="_nKmKHA1e7HajRSAZLVX-13" style="text;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1">
          <mxGeometry height="30" width="179" y="280" as="geometry" />
        </mxCell>
        <mxCell id="f7H6KHkmW85j-XaXgy8H-10" parent="_nKmKHA1e7HajRSAZLVX-13" style="text;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1">
