        </mxCell>
        <mxCell id="_nKmKHA1e7HajRSAZLVX-18" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="Антон" vertex="1">
          <mxGeometry height="440" width="190" x="416" y="260" as="geometry" />
        </mxCell>
        <mxCell id="_nKmKHA1e7HajRSAZLVX-19" parent="_nKmKHA1e7HajRSAZLVX-18" style="text;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Молодой токарь" vertex="1">
          <mxGeometry height="30" width="190" y="30" as="geometry" />
        </mxCell>
        <mxCell id="_nKmKHA1e7HajRSAZLVX-20" parent="_nKmKHA1e7HajRSAZLVX-18" style="text;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Недавно закончил учёбу. Стажируется на производстве." vertex="1">
          <mxGeometry height="80" width="190" y="60" as="geometry" />
        </mxCell>
        <mxCell id="_nKmKHA1e7HajRSAZLVX-21" parent="_nKmKHA1e7HajRSAZLVX-18" style="text;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Всегда любил игры и уделял им много времени. Сейчас стажируется на заводе на должность токаря. Уже несколько лет встречается с девушкой. Может уделять играм 2-3 часа в день, но предпочитает проводить это время со своей любимой. Хотел бы попробовать поиграть с ней вместе, или просто ввести её в мир гейминга, из-за чего ищет простенькие проекты для новичков и игры с возможностью совместной игры." vertex="1">
          <mxGeometry height="240" width="190" y="140" as="geometry" />
        </mxCell>
        <mxCell id="f7H6KHkmW85j-XaXgy8H-7" parent="_nKmKHA1e7HajRSAZLVX-18" style="text;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1">
          <mxGeometry height="30" width="190" y="380" as="geometry" />
        </mxCell>
        <mxCell id="f7H6KHkmW85j-XaXgy8H-8" parent="_nKmKHA1e7HajRSAZLVX-18" style="text;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1">
          <mxGeometry height="30" width="190" y="410" as="geometry" />
        </mxCell>
        <mxCell id="_nKmKHA1e7HajRSAZLVX-24" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="Джейми" vertex="1">
          <mxGeometry height="340" width="179" x="620" y="260" as="geometry" />
        </mxCell>
        <mxCell id="_nKmKHA1e7HajRSAZLVX-25" parent="_nKmKHA1e7HajRSAZLVX-24" style="text;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Пенсионер" vertex="1">
          <mxGeometry height="30" width="179" y="30" as="geometry" />
        </mxCell>
        <mxCell id="_nKmKHA1e7HajRSAZLVX-26" parent="_nKmKHA1e7HajRSAZLVX-24" style="text;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Геймер со стажем. Любит проводить время с внуками." vertex="1">
          <mxGeometry height="80" width="179" y="60" as="geometry" />
        </mxCell>
        <mxCell id="_nKmKHA1e7HajRSAZLVX-27" parent="_nKmKHA1e7HajRSAZLVX-24" style="text;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Много времени проводит со своими малолетними внуками, из-за чего не может позволить себе уделять много времени на игры. Предпочитает простенькие игры, которые в случае чего можно показать и маленьким детям." vertex="1">
          <mxGeometry height="140" width="179" y="140" as="geometry" />
        </mxCell>
